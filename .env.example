# ==============================================================================
# Pomodoroz 环境变量示例配置
# ==============================================================================
# 部署至 Cloudflare Pages 或本地开发测试时，请在项目根目录复制为 .env 或在控制台配置。
#
# 安全警告：
# 1. 前端应用仅可配置 VITE_SUPABASE_URL 与 VITE_SUPABASE_ANON_KEY (公开客户端密钥)；
# 2. 严禁在此处或任何前端代码中填入 service_role 或任何服务端管理密钥！
# 3. 数据安全全部由 Supabase PostgreSQL 的 Row Level Security (RLS) 强制保障。
# ==============================================================================

# Supabase 项目 URL（在 Supabase 控制台 Project Settings -> API 中查看）
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 匿名公开客户端密钥 (anon / public key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_public_anon_key
